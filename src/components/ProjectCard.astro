---
import { Image } from "astro:assets";
import { ExternalLink} from "@lucide/astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  categoryLabel?: string;
}

const { project} = Astro.props;
---

<article class="card overflow-hidden rounded-[12px] border border-transparent shadow-lg hover:border-primary hover:shadow-2xl hover:opacity-90 transition-all duration-[250ms]">
  <a
    href={project.data.sourceLink}
    target="_blank"
    rel="noopener noreferrer"
  >
    <figure class="aspect-video">
      <Image
        src={project.data.image}
        alt={project.data.title}
        class="w-full h-full object-cover"
        width={600}
        height={400}
      />
    </figure>
    <div class="card-body ">
      <h3 class="card-title">
        {project.data.title}
      </h3>
      <p class="text-base-content/80">{project.data.description}</p>
    </div>
  </a>
</article>
