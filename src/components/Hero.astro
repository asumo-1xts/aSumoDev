---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getIcon } from "../utils/iconMapper";
import { parseInlineLinks } from "../utils/parseInlineLinks";

interface Props {
  hero: {
    message?: string;
    avatar: ImageMetadata;
    name: string;
    title: string;
    location?: string;
    email: string;
    discord: string;
    socialLinks: Array<{
      url: string;
      icon: string;
      label: string;
    }>;
  };
}

const { hero } = Astro.props;
---

<section class="hero min-h-screen">
  <div class="hero-content flex-col lg:flex-row-reverse max-w-7xl">
    <div>
      {
        hero.message && (
          <h2 class="text-xl text-base-content/80 mb-2 text-center" set:html={parseInlineLinks(hero.message)} />
        )
      }
      <figure class="max-w-100 w-48 lg:w-64 my-4 mask mask-squircle">
        {
          <Image
            src={hero.avatar}
            alt={hero.name}
            width={256}
            height={256}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            format="webp"
            quality={80}
          />
        }
      </figure>
    </div>
    <div class="max-w-2xl text-center lg:text-left">
      <p class="text-4xl lg:text-5xl font-bold mb-4">
        {hero.name}
      </p>
      <h1 class="text-xl text-base-content/80 mb-2" set:html={parseInlineLinks(hero.title)} />
      {
        hero.location && (
          <p class="text-base-content/60 mb-4">{hero.location}</p>
        )
      }
      <p class="text-lg leading-relaxed mb-6">
        <span set:html={parseInlineLinks(`📧${hero.email}`)} /><br />
        <span set:html={parseInlineLinks(`🎮${hero.discord}`)} />
      </p>
      <div
        class="grid grid-cols-4 gap-2 justify-items-center lg:flex lg:gap-4 lg:justify-start"
      >
        {
          hero.socialLinks.map((link) => {
            const IconComponent = getIcon(link.icon as any);
            return (
              <div class="tooltip tooltip-top" data-tip={link.label}>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-circle btn-primary lg:btn-ghost"
                  aria-label={link.label}
                >
                  <IconComponent class="size-6" />
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
